# ===========================================================================
# Конфигурация MAX-бота для розыгрышей. Скопируйте в .env и заполните.
#   cp .env.example .env
# ВАЖНО: .env никогда не коммитить (уже в .gitignore).
#         НИКОГДА не вставляйте сюда реальный токен — только плейсхолдер.
# ===========================================================================

# Токен бота (выдаёт MasterBot при создании бота в MAX).
# НЕ КОММИТИТЬ. Получите свой через @MasterBot в MAX.
BOT_TOKEN=ВАШ_ТОКЕН_ЗДЕСЬ

# Публичный HTTPS-URL, на который MAX будет слать webhook.
# С 25 мая платформа требует именно HTTPS (HTTP запрещён).
# Порт 443 подразумевается по умолчанию и НЕ указывается.
# Примеры:
#   https://giveaway.example.com            (свой домен + reverse-proxy)
#   https://bot.example.com                 (named Cloudflare Tunnel — см. deploy/cloudflared/SETUP.md)
#   https://something.trycloudflare.com     (временный quick-tunnel, только для теста)
WEBHOOK_URL=https://giveaway.example.com

# Секрет для webhook (5-256 символов: латиница, цифры, дефис).
# MAX шлёт его в заголовке X-Max-Bot-Api-Secret при каждом запросе.
WEBHOOK_SECRET=change-me-to-a-long-random-string-123456

# Локальный порт HTTP-сервера бота (внутри контейнера/VPS).
HTTP_PORT=8080

# Путь вебхука на сервере. Полный URL = WEBHOOK_URL + WEBHOOK_PATH
WEBHOOK_PATH=/webhook

# ---------------------------------------------------------------------------
# TLS / сертификат Минцифры
# ---------------------------------------------------------------------------
# НИЧЕГО НАСТРАИВАТЬ НЕ НУЖНО. Корневой сертификат Минцифры (Russian Trusted
# Root CA) встроен в бинарник через //go:embed (internal/config/certs/).
# TLS к platform-api2.max.ru работает из коробки — без SSL_CERT_FILE.
# Сами PEM-файлы — публичные, коммитятся в репо.

# ---------------------------------------------------------------------------
# База данных PostgreSQL
# ---------------------------------------------------------------------------
# Формат: postgres://USER:PASSWORD@HOST:PORT/DBNAME?sslmode=disable
DB_DSN=postgres://giveaway:giveaway@localhost:5432/giveaway?sslmode=disable

# Применять миграции при старте бота (true/false)
DB_MIGRATE=true

# ---------------------------------------------------------------------------
# Часовой пояс. Бот живёт по МСК — критично для дат публикации/итогов.
# ---------------------------------------------------------------------------
TZ=Europe/Moscow

# Лимит запросов к платформе MAX (требование: не более 30 rps).
# Оставьте как есть, если не понимаете последствий.
MAX_RPS=28

# Уровень логирования: debug / info / warn / error
LOG_LEVEL=info
